# Local defaults match docker-compose.yml. In production every value comes from Render.
APP_ENV=development
DATABASE_URL=postgres://pocket:pocket@localhost:55432/pocket
REDIS_URL=redis://localhost:56379
PORT=4000
# Optional in development (a fixed dev secret is used with a warning). Required in production.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Optional origins allowed only anonymous GET/HEAD. Leave empty in production.
PREVIEW_ORIGINS=
STOREFRONT_URL=http://localhost:5173
# Required when APP_ENV=production; fixture password demo1234 is used otherwise.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
REDIS_PREFIX=ps:
SEED_SCALE=full
LOGIN_RATE_LIMIT_PER_MIN=10
CATALOG_RATE_LIMIT_PER_MIN=120
