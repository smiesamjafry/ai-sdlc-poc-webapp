{
  "name": "ai-sdlc-poc-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pocket Shop: storefront + admin (React) with an Express/Postgres/Redis API; target repo for the ASDLC Slack-to-PR POC",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "npm run dev -w server",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w server",
    "test": "vitest run",
    "test:api": "npm run test -w server",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run test:api && npm run test:e2e",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server --"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "server",
    "shared"
  ]
}
